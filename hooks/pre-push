#!/usr/bin/env bash
# ido-pipeline guard: blocks pushing to main/master from this machine.
# Changes reach main only by merging a Pull Request on GitHub.
# Emergency override (first push of a brand-new repo, or a real emergency):  ALLOW_MAIN_PUSH=1 git push ...
[ "${ALLOW_MAIN_PUSH:-0}" = "1" ] && exit 0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "✋ Push to ${remote_ref#refs/heads/} blocked. Push a branch and open a Pull Request instead." >&2
      exit 1 ;;
  esac
done
exit 0
